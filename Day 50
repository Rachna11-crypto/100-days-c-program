Change the date format from dd/04/yyyy to dd-Apr-yyyy.

#include <stdio.h>

int main()
{
    int dd, mm, yyyy;

    scanf("%d/%d/%d", &dd, &mm, &yyyy);

    if(mm == 4)
        printf("%02d-Apr-%04d", dd, yyyy);
    else
        printf("Invalid month");

    return 0;
}

Print all sub-strings of a string.

#include <stdio.h>

int main()
{
    char str[100];
    int i, j, k;

    scanf("%99s", str);

    for(i = 0; str[i] != '\0'; i++)
    {
        for(j = i; str[j] != '\0'; j++)
        {
            for(k = i; k <= j; k++)
            {
                printf("%c", str[k]);
            }

            printf("\n");
        }
    }

    return 0;
}
