Find the sum of each row of a matrix and store it in an array.
#include <stdio.h>

int main() {
    int r, c, i, j;

    scanf("%d %d", &r, &c);

    int a[r][c];
    int rowSum[r];

    for (i = 0; i < r; i++) {
        rowSum[i] = 0;

        for (j = 0; j < c; j++) {
            scanf("%d", &a[i][j]);
            rowSum[i] += a[i][j];
        }
    }

    for (i = 0; i < r; i++)
        printf("%d ", rowSum[i]);

    return 0;
}
Find the transpose of a matrix.
#include <stdio.h>

int main() {
    int r, c, i, j;

    scanf("%d %d", &r, &c);

    int a[r][c];

    for (i = 0; i < r; i++) {
        for (j = 0; j < c; j++)
            scanf("%d", &a[i][j]);
    }

    for (j = 0; j < c; j++) {
        for (i = 0; i < r; i++)
            printf("%d ", a[i][j]);

        printf("\n");
    }

    return 0;
}
