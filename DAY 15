Write a program to calculate the factorial of a number.
#include <stdio.h>

int main() {
    int n, i;
    long long fact = 1;

    scanf("%d", &n);

    for (i = 1; i <= n; i++)
        fact *= i;

    printf("Factorial = %lld", fact);

    return 0;
}

Write a program to reverse a given number.
#include <stdio.h>

int main() {
    int n, reverse = 0, digit;

    scanf("%d", &n);

    while (n != 0) {
        digit = n % 10;
        reverse = reverse * 10 + digit;
        n /= 10;
    }

    printf("Reverse = %d", reverse);

    return 0;
}
