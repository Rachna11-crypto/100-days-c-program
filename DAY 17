Write a program to check if a number is an Armstrong number.
#include <stdio.h>

int main() {
    int n, original, temp, digit;
    int sum = 0, count = 0, power, i;

    scanf("%d", &n);

    original = n;
    temp = n;

    while (temp != 0) {
        count++;
        temp /= 10;
    }

    temp = n;

    while (temp != 0) {
        digit = temp % 10;
        power = 1;

        for (i = 1; i <= count; i++)
            power *= digit;

        sum += power;
        temp /= 10;
    }

    if (sum == original)
        printf("Armstrong Number");
    else
        printf("Not an Armstrong Number");

    return 0;
}

Write a program to check if a number is prime.
#include <stdio.h>

int main() {
    int n, i, prime = 1;

    scanf("%d", &n);

    if (n < 2)
        prime = 0;

    for (i = 2; i * i <= n; i++) {
        if (n % i == 0) {
            prime = 0;
            break;
        }
    }

    if (prime)
        printf("Prime");
    else
        printf("Not Prime");

    return 0;
}
