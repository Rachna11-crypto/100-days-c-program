Check if two strings are anagrams of each other.

#include <stdio.h>

int main()
{
    char a[100], b[100];
    int count[256] = {0};
    int i, flag = 1;

    scanf("%99s %99s", a, b);

    for(i = 0; a[i] != '\0'; i++)
        count[(unsigned char)a[i]]++;

    for(i = 0; b[i] != '\0'; i++)
        count[(unsigned char)b[i]]--;

    for(i = 0; i < 256; i++)
    {
        if(count[i] != 0)
        {
            flag = 0;
            break;
        }
    }

    if(flag == 1)
        printf("Anagrams");
    else
        printf("Not anagrams");

    return 0;
}

Find the longest word in a sentence.

#include <stdio.h>

int main()
{
    char str[200], word[100], longest[100];
    int i = 0, j, k, max = 0, len;

    fgets(str, sizeof(str), stdin);

    while(str[i] != '\0')
    {
        while(str[i] == ' ' || str[i] == '\n')
            i++;

        j = 0;

        while(str[i] != ' ' && str[i] != '\n' &&
              str[i] != '\0')
        {
            word[j++] = str[i++];
        }

        word[j] = '\0';
        len = j;

        if(len > max)
        {
            max = len;

            for(k = 0; k <= len; k++)
                longest[k] = word[k];
        }

        if(str[i] == '\0')
            break;
    }

    printf("%s", longest);

    return 0;
}
