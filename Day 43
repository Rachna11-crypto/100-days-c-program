Reverse a string.

#include <stdio.h>

int main()
{
    char str[100];
    int i, len = 0;

    fgets(str, sizeof(str), stdin);

    while(str[len] != '\0' && str[len] != '\n')
        len++;

    for(i = len - 1; i >= 0; i--)
    {
        printf("%c", str[i]);
    }

    return 0;
}
Check if a string is a palindrome.

#include <stdio.h>

int main()
{
    char str[100];
    int i, len = 0, flag = 1;

    fgets(str, sizeof(str), stdin);

    while(str[len] != '\0' && str[len] != '\n')
        len++;

    for(i = 0; i < len / 2; i++)
    {
        if(str[i] != str[len - i - 1])
        {
            flag = 0;
            break;
        }
    }

    if(flag == 1)
        printf("Palindrome");
    else
        printf("Not palindrome");

    return 0;
}
