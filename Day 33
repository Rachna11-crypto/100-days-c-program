Search in a sorted array using binary search.
#include <stdio.h>

int main() {
    int n, i, key;
    int low, high, mid, found = -1;

    scanf("%d", &n);

    int a[n];

    for (i = 0; i < n; i++)
        scanf("%d", &a[i]);

    scanf("%d", &key);

    low = 0;
    high = n - 1;

    while (low <= high) {
        mid = (low + high) / 2;

        if (a[mid] == key) {
            found = mid;
            break;
        }
        else if (a[mid] < key)
            low = mid + 1;
        else
            high = mid - 1;
    }

    if (found != -1)
        printf("Found at index %d", found);
    else
        printf("-1");

    return 0;
}

Insert an element in a sorted array at the appropriate position.
#include <stdio.h>

int main() {
    int n, i, value, pos;

    scanf("%d", &n);

    int a[n + 1];

    for (i = 0; i < n; i++)
        scanf("%d", &a[i]);

    scanf("%d", &value);

    pos = 0;

    while (pos < n && a[pos] < value)
        pos++;

    for (i = n; i > pos; i--)
        a[i] = a[i - 1];

    a[pos] = value;

    for (i = 0; i <= n; i++)
        printf("%d ", a[i]);

    return 0;
}
