Remove all vowels from a string.

#include <stdio.h>

int main()
{
    char str[100];
    int i, j = 0;

    fgets(str, sizeof(str), stdin);

    for(i = 0; str[i] != '\0'; i++)
    {
        char ch = str[i];

        if(ch != 'a' && ch != 'e' && ch != 'i' &&
           ch != 'o' && ch != 'u' &&
           ch != 'A' && ch != 'E' && ch != 'I' &&
           ch != 'O' && ch != 'U')
        {
            str[j] = str[i];
            j++;
        }
    }

    str[j] = '\0';

    printf("%s", str);

    return 0;
}
Find the first repeating lowercase alphabet in a string.

#include <stdio.h>

int main()
{
    char str[100];
    int i, j, found = 0;

    fgets(str, sizeof(str), stdin);

    for(i = 0; str[i] != '\0' && str[i] != '\n'; i++)
    {
        for(j = i + 1; str[j] != '\0' && str[j] != '\n'; j++)
        {
            if(str[i] == str[j] &&
               str[i] >= 'a' && str[i] <= 'z')
            {
                printf("%c", str[i]);
                found = 1;
                break;
            }
        }

        if(found == 1)
            break;
    }

    if(found == 0)
        printf("No repeating character");

    return 0;
}
