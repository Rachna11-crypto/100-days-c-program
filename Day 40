Perform diagonal traversal of a matrix.

#include <stdio.h>

int main()
{
    int a[100][100], r, c, i, j;

    scanf("%d %d", &r, &c);

    for(i = 0; i < r; i++)
    {
        for(j = 0; j < c; j++)
        {
            scanf("%d", &a[i][j]);
        }
    }

    // Start from first row
    for(j = 0; j < c; j++)
    {
        i = 0;
        int col = j;

        while(i < r && col >= 0)
        {
            printf("%d ", a[i][col]);
            i++;
            col--;
        }
    }

    // Start from first column
    for(i = 1; i < r; i++)
    {
        int row = i;
        j = c - 1;

        while(row < r && j >= 0)
        {
            printf("%d ", a[row][j]);
            row++;
            j--;
        }
    }

    return 0;
}

Multiply two matrices.

#include <stdio.h>

int main()
{
    int a[100][100], b[100][100], c[100][100];
    int r1, c1, r2, c2, i, j, k;

    scanf("%d %d", &r1, &c1);

    for(i = 0; i < r1; i++)
        for(j = 0; j < c1; j++)
            scanf("%d", &a[i][j]);

    scanf("%d %d", &r2, &c2);

    for(i = 0; i < r2; i++)
        for(j = 0; j < c2; j++)
            scanf("%d", &b[i][j]);

    if(c1 != r2)
    {
        printf("Multiplication not possible");
        return 0;
    }

    for(i = 0; i < r1; i++)
    {
        for(j = 0; j < c2; j++)
        {
            c[i][j] = 0;

            for(k = 0; k < c1; k++)
            {
                c[i][j] += a[i][k] * b[k][j];
            }
        }
    }

    for(i = 0; i < r1; i++)
    {
        for(j = 0; j < c2; j++)
            printf("%d ", c[i][j]);

        printf("\n");
    }

    return 0;
}
