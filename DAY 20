Write a program to find the product of odd digits of a number.
  #include <stdio.h>

int main() {
    int n, digit;
    int product = 1;
    int found = 0;

    scanf("%d", &n);

    while (n != 0) {
        digit = n % 10;

        if (digit % 2 != 0) {
            product *= digit;
            found = 1;
        }

        n /= 10;
    }

    if (found)
        printf("Product = %d", product);
    else
        printf("No odd digit");

    return 0;
}
Write a program to find the 1’s complement of a binary number and print it.
  #include <stdio.h>

int main() {
    long long n, result = 0, place = 1;
    int digit;

    scanf("%lld", &n);

    while (n != 0) {
        digit = n % 10;

        if (digit == 0)
            digit = 1;
        else
            digit = 0;

        result += digit * place;
        place *= 10;
        n /= 10;
    }

    printf("%lld", result);

    return 0;
}
