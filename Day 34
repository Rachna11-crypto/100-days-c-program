Insert an element in an array at a given position.
#include <stdio.h>

int main() {
    int n, i, value, pos;

    scanf("%d", &n);

    int a[n + 1];

    for (i = 0; i < n; i++)
        scanf("%d", &a[i]);

    scanf("%d", &value);
    scanf("%d", &pos);

    for (i = n; i > pos; i--)
        a[i] = a[i - 1];

    a[pos] = value;

    for (i = 0; i <= n; i++)
        printf("%d ", a[i]);

    return 0;
}

Delete an element from an array.
#include <stdio.h>

int main() {
    int n, i, pos;

    scanf("%d", &n);

    int a[n];

    for (i = 0; i < n; i++)
        scanf("%d", &a[i]);

    scanf("%d", &pos);

    for (i = pos; i < n - 1; i++)
        a[i] = a[i + 1];

    for (i = 0; i < n - 1; i++)
        printf("%d ", a[i]);

    return 0;
}
