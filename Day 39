Check if the elements on the diagonal matrix are distinct.

#include <stdio.h>

int main()
{
    int a[100][100], r, c, i, j;
    int flag = 1;

    scanf("%d %d", &r, &c);

    for(i = 0; i < r; i++)
    {
        for(j = 0; j < c; j++)
        {
            scanf("%d", &a[i][j]);
        }
    }

    if(r != c)
    {
        printf("False");
        return 0;
    }

    for(i = 0; i < r; i++)
    {
        for(j = i + 1; j < r; j++)
        {
            if(a[i][i] == a[j][j])
            {
                flag = 0;
                break;
            }
        }
    }

    if(flag == 1)
        printf("True");
    else
        printf("False");

    return 0;
}

Find the sum of main diagonal elements for a square matrix

#include <stdio.h>

int main()
{
    int a[100][100], n, i, j, sum = 0;

    scanf("%d", &n);

    for(i = 0; i < n; i++)
    {
        for(j = 0; j < n; j++)
        {
            scanf("%d", &a[i][j]);
        }
    }

    for(i = 0; i < n; i++)
    {
        sum = sum + a[i][i];
    }

    printf("%d", sum);

    return 0;
}
