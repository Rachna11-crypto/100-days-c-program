Print the initials of a name.

#include <stdio.h>

int main()
{
    char str[100];
    int i;

    fgets(str, sizeof(str), stdin);

    if(str[0] != ' ' && str[0] != '\n')
        printf("%c.", str[0]);

    for(i = 1; str[i] != '\0'; i++)
    {
        if(str[i] == ' ' && str[i+1] != ' ' &&
           str[i+1] != '\n' && str[i+1] != '\0')
        {
            printf("%c.", str[i+1]);
        }
    }

    return 0;
}

Print initials of a name with the surname displayed in full.


#include <stdio.h>

int main()
{
    char str[100];
    int i, last = 0;

    fgets(str, sizeof(str), stdin);

    for(i = 0; str[i] != '\0' && str[i] != '\n'; i++)
    {
        if(str[i] == ' ')
            last = i + 1;
    }

    for(i = 0; i < last; i++)
    {
        if(i == 0 && str[i] != ' ')
            printf("%c.", str[i]);

        else if(str[i] == ' ' && str[i+1] != ' ')
            printf("%c.", str[i+1]);
    }

    printf("%s", str + last);

    return 0;
}
